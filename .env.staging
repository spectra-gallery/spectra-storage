# Spectra Storage — staging

NODE_ENV=production
PORT=6601

# Origins
CLIENT_URL=https://staging.spectra.gallery
BACKEND_API_URL=https://api.staging.spectra.gallery

# Uploads
UPLOAD_HTML_MAX_SIZE=2097152
UPLOAD_MAX_SIZE=104857600
RESIZE_TRESHOLD=2097152
USER_STORAGE=/storage/user/
UPLOAD_PATH=/ressources/storage/

# WebAuthn / Sessions (set real secrets via secure ops channel)
SESSION_SECRET=
API_SESSION_SECRET=
STORAGE_SESSION_SECRET=
RP_ID=staging.spectra.gallery
WEBAUTHN_ORIGIN=https://storage.staging.spectra.gallery

# Mongo (staging)
DB_HOST=127.0.0.1
DB_PORT=27017
DB_NAME=spectra_staging
DB_AUTH_SOURCE=spectra
SKIP_DB=0

# Mail (optional)
MAIL_HOST=mail.infomaniak.com
MAIL_PORT=465
SPECTRA_EMAIL=artist@spectra.gallery
ADMIN_EMAIL=
MAIL_PASSWORD=

