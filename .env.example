# Spectra Storage — staging/production example

# HTTP port
PORT=6601

# CORS origins (frontend + backend)
CLIENT_URL=http://localhost:3000
BACKEND_API_URL=http://localhost:8000

# Puppeteer (optional overrides)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PUPPETEER_HEADLESS=new
# Set a custom profile dir if needed
# PUPPETEER_USER_DATA_DIR=/var/www/spectra-gallery/spectra-storage/.puppeteer_profile

# Cap concurrent Chromium instances to avoid OOM
PUPPETEER_MAX_CONCURRENCY=1

# Upload limits (bytes)
UPLOAD_HTML_MAX_SIZE=1048576
UPLOAD_MAX_SIZE=10485760

# WebAuthn / Sessions
SESSION_SECRET=change-me
RP_ID=yourdomain.com
WEBAUTHN_ORIGIN=https://yourdomain.com

# MongoDB (optional for sessions)
DB_HOST=127.0.0.1
DB_PORT=27017
DB_NAME=spectra
# DB_USER=
# DB_PASSWORD=
DB_AUTH_SOURCE=spectra

# Set to 1 to skip Mongo-backed sessions (use MemoryStore)
SKIP_DB=1
